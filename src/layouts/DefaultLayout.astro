---
import '../css/main.css';

const {title} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="format-detection" content="telephone=no">
        <meta name="title" content={`${(title) ? `${title} - ` : ''}95 Degrees Cafe ☕`}>
        <meta name="description" content="Serving coffee and conversation 24/7 since 2016 - 95 Degrees is a welcoming Discord server with many exclusive features.">
        <meta name="keywords" content="discord, server, community, 95 degrees, cafe">
        <meta name="robots" content="index, follow">
        <meta name="language" content="english">
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://www.95degrees.cafe/">
        <meta property="og:title" content={`${(title) ? `${title} - ` : ''}95 Degrees Cafe ☕`}>
        <meta property="og:description" content="Serving coffee and conversation 24/7 since 2016 - 95 Degrees is a welcoming Discord server with many exclusive features.">
        <meta property="og:image" content="https://www.95degrees.cafe/nf-card.png">
        <meta property="twitter:card" content="summary_large_image">
        <meta property="twitter:url" content="https://www.95degrees.cafe/">
        <meta property="twitter:title" content={`${(title) ? `${title} - ` : ''}95 Degrees Cafe ☕`}>
        <meta property="twitter:description" content="Serving coffee and conversation 24/7 since 2016 - 95 Degrees is a welcoming Discord server with many exclusive features.">
        <meta property="twitter:image" content="https://www.95degrees.cafe/nf-card.png">
        <title>{(title) ? `${title} - ` : ''}95 Degrees Cafe ☕</title>
        <link rel="icon" href="favicon.png" type="image/png">
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Montserrat:wght@700;800&display=swap">
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-DHSBY11WJ5"></script>
        <script is:inline>
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());

            gtag('config', 'G-DHSBY11WJ5');
        </script>
    </head>

    <body>
        <slot/>
    </body>
</html>