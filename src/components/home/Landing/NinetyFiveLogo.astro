---
import Logo from "../../common/Logo.astro";
---

<div id="logo" class="flex flex-col items-center pointer-events-none z-50 filter drop-shadow-xl">
    <div class="mb-0 md:mb-4 w-60 2xl:w-72 logoScaleInHold logoScaleInAnim">
        <Logo/>
    </div>
    <h1 class="font-title text-4xl 2xl:text-5xl text-center hidden md:block max-w-lg xl:max-w-none subFadeIn" id="landing-sub-1">serving coffee and conversation 24/7</h1>
    <h1 class="font-title text-4xl 2xl:text-5xl text-center hidden md:block subFadeIn" id="landing-sub-2">since 2016</h1>
</div>

<style>
    /* logo scale in */
    .logoScaleInHold {
        transform:scale(100);
    }
    .logoScaleInAnim {
        animation:logoScaleInAnim 0.9s forwards cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes logoScaleInAnim {
        from {
            transform:scale(100);
        }
        to {
            transform:scale(1);
        }
    }

    /* subtitle fade in */
    .subFadeHold {
        opacity:0;
    }
    .subFadeIn {
        opacity:0;
        animation:subFadeIn 0.7s 1s forwards cubic-bezier(0.22, 1, 0.36, 1);
    }
    @keyframes subFadeIn {
        from {
            opacity:0;
            transform:translateY(-24px);
        }
        to {
            opacity:1;
            transform:translateY(0px);
        }
    }
</style>