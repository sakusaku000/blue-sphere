---
import Background from "./Landing/Background.astro";
import NinetyFiveLogo from "./Landing/NinetyFiveLogo.astro";
import SocialLinks from "./Landing/SocialLinks.astro";
import ScrollIndicator from "./Landing/ScrollIndicator.astro";
---

<div id="landing" class="relative text-white h-screen md:p-0 flex flex-col gap-7 2xl:gap-10 items-center justify-center select-none overflow-hidden" style="min-height:100svh!important">
    <Background/>
    <NinetyFiveLogo/>
    <SocialLinks/>
    <ScrollIndicator/>
</div>

<style>
    #landing {
        background-color:#95cafe;
        background-image:url(/assets/mashup/mashup_bg_loop_hold_frame.webp);
        background-size:cover;
        background-position:center;
    }
</style>