---
import Container from "../common/Container.astro";
---

<div id="mashup" class="relative mashup_2023_bg">
    <div class="absolute inset-0 bg-[#00000050]"></div>
    <Container customClass="relative !z-50 text-white drop-shadow" smaller={false}>
        <div class="grid grid-cols-1 lg:grid-cols-2 lg:items-center gap-10 z-50">
            <div class="row-start-2 lg:row-start-1">
                <iframe class="aspect-video w-full h-full rounded-lg shadow-lg" width="560" height="315" src="https://www.youtube.com/embed/T4k6Vc8Ldlg?start=1992" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
            </div>
            <div>
                <img class="mb-6 md:w-5/6 mx-auto lg:mx-0" src="/assets/mashup_2023/mashup_2023_logo_glow.png" alt="95 Degrees Mashup 2023" draggable="false">
                <hr class="mb-4 opacity-25">
                <h2 class="text-lg mb-1 font-bold font-title text-center lg:text-left">celebrating 7 years with our biggest event ever!</h2>
                <p class="text-justify">
                    the 95 degrees mashup is a yearly celebration of our community, combining awards, announcements, highlights, giveaways, trivia and special surprises in a fun, interactive
                    live stream! we celebrated live on the 8th july with our community, but even if you missed it you can still <span class="inline lg:hidden">check it out below!</span> <span class="hidden lg:inline">check it out here!</span>
                </p>
            </div>
        </div>
    </Container>
</div>

<style>
    .mashup_2023_bg {
        background-image:url(/assets/mashup_2023/mashup_2023_bg.webp);
        background-size:cover;
        background-position:center;
        box-shadow:0px 0px 20px #00000090 inset;
    }
</style>