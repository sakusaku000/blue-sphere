---
export interface Props {
    name:string;
    icon:string;
    customClass:string;
}
const {name, icon, customClass} = Astro.props;
---

<div class={`p-5 bg-gray-100 rounded-2xl ${customClass}`}>
    <div class="flex items-center gap-3 mb-2">
        <img class="rounded-full w-10 shadow" src={icon}>
        <h1 class="font-title text-xl text-brand-dark">{name}</h1>
    </div>
    <p class="text-justify text-sm">
        <slot/>
    </p>
</div>