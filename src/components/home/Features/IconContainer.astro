---
import {Icon} from 'astro-icon';

export interface Props {
    icon:string;
}
const {icon} = Astro.props;
---

<div class="w-20 h-20 p-5 mb-2 bg-brand-dark text-white rounded-full flex items-center justify-center mx-auto lg:mx-0 shadow">
    <Icon name={icon}/>
</div>

<style>
    svg {
        @apply w-full;
    }
</style>