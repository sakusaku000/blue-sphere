---
import Layout from "../Layout.astro";
import IconContainer from "../IconContainer.astro";
import ThumbnailCollection from '../ThumbnailCollection.astro';
---

<Layout customClass="bg-gray-50">
    <!-- LEFT -->
    <div>
        <IconContainer icon="calendar"/>
        <h1 class="features-header">regular events</h1>
        <hr class="features-divider">
        <p class="features-details">
            we're always running exciting events that keep our community engaged
            such as game nights, questions of the week, team tournaments, <a href="/#mashup" class="underline">the 95 degrees mashup</a> and much more!
        </p>
    </div>

    <!-- RIGHT -->
    <div>
        <ThumbnailCollection
        pic1="/assets/features/events/amongus.png" 
        pic2="/assets/features/events/gartic.png" 
        pic3="/assets/features/events/teamtournament.png"
        reverse={true}
        />
    </div>
</Layout>