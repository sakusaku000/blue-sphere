---
import {Icon} from 'astro-icon';
import Layout from "../Layout.astro";
import IconContainer from "../IconContainer.astro";
import CustomBotDetail from '../CustomBotDetail.astro';
---

<Layout customClass="bg-gray-50">
    <!-- LEFT -->
    <div>
        <IconContainer>
            <Icon name="robot"/>
        </IconContainer>
        <h1 class="features-header">custom bots</h1>
        <hr class="features-divider">
        <p class="features-details">
            a selection of custom-coded bots developed by our staff run in our server and offer the community a variety of unique and convenient features.
        </p>
    </div>

    <!-- RIGHT -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 mt-5">
        <CustomBotDetail name="guardian" icon="/assets/features/bots/guardian.png" customClass="col-span-2 xl:col-span-1">
            our main bot that offers many different features, including member quotes, community events, an xp + levelling system, and a customisable profile.
        </CustomBotDetail>
        <CustomBotDetail name="95 degrees radio" icon="/assets/features/bots/radio.png" customClass="col-span-2 xl:col-span-1">
            95 degrees' very own exclusive radio station! always playing songs of many different genres + user requests 24/7 whenever you wanna listen! 
        </CustomBotDetail>
        <CustomBotDetail name="bannerista" icon="/assets/features/bots/bannerista.png" customClass="col-span-2">
            a bot that tracks activity in the server by our members and generates a daily server banner with the most active to least active members for that day.
        </CustomBotDetail>
    </div>
</Layout>