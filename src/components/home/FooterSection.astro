---
import {Icon} from 'astro-icon';
import MainButton from "../common/MainButton.astro";
import GoToTop from './FooterSection/GoToTop.astro';
---

<div id="footer" class="text-gray-300 px-4 md:px-10 py-10 text-center">
    <!-- go to top -->
    <GoToTop/>

    <!-- socials -->
    <div class="flex flex-col items-center max-w-md mx-auto mb-10">
        <a href="https://discord.gg/pGNTBA5Nkk" target="_blank">
            <MainButton><Icon name="discord" class="w-8 mr-4"/>join us: discord.gg/95degrees</MainButton>
        </a>
    </div>

    <!-- copyright - credit -->
    <p class="mt-5 select-none">© 2022 95 Degrees</p>
    <span class="text-xs text-gray-400 select-none">site created by <a href="https://saku.zone/" class="underline" target="_blank">saku</a> ♡</span>
</div>

<style>
    #footer {
        background-color:#2A2A2A;
    }
</style>