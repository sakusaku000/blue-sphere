    />

    <StaffCard
        name="jaetpa" 
        role="Assistant"
        icon={url + '146608140899581952.png'}
    />

    <StaffCard
        name="TagmanBeesley" 
        role="Barista"
        icon={url + '147801925230788608.png'}
        socialLink="https://twitter.com/tagmanbeesley"
    />

    <StaffCard
        name="hyuua" 
        role="Barista / Developer"
        icon={url + '255673616342056961.png'}
    />

    <StaffCard
        name="VoidInVoid" 
        role="Developer"
        icon={url + '121387133821911040.png'}
