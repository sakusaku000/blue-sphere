---
export interface Props {
    name:string
    role?:string
    icon:string
    regular?:boolean
    socialLink?:string
}
const {name, role, icon, regular, socialLink} = Astro.props;

import {Icon} from "astro-icon";
---

<a href={socialLink} target="_blank">
    <div class="flex gap-3 md:gap-5 items-center rounded-3xl p-3 md:p-5 bg-black/5 md:hover:bg-black/10 md:hover:shadow duration-200 group select-none relative">
        <img class={`rounded-2xl md:rounded-3xl shadow-sm w-20 md:w-28 lg::w-32 bg-black/10`} src={icon} alt={`${name}'s avatar`} draggable="false">
        <div class={`p-1 rounded-lg group-hover:opacity-100 duration-200 filter drop-shadow-sm`}>
            <h1 class={`font-bold md:text-xl lg:text-2xl`}>{name}</h1>
            <h2 class={`text-xs lg:text-md ${(role) ? 'block' : 'hidden'}`}>{role}</h2>
        </div>

        <Icon name="linkout" class={`w-3 h-3 md:w-5 md:h-5 ${(socialLink) ? 'absolute' : 'hidden'} top-0 right-0 m-2 md:m-3 opacity-50 md:opacity-0 group-hover:opacity-50 duration-200`}/>
    </div>
</a>