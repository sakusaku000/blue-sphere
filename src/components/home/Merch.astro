---
import {Icon} from 'astro-icon';
import Container from "../common/Container.astro";
import MainButton from "../common/MainButton.astro";
---

<div id="merch" class="merch-bg-img text-white">
    <Container customClass="filter drop-shadow-xl text-center md:text-left" smaller={false}>
        <div class="flex items-center justify-center md:justify-between flex-wrap">
            <div>
                <h1 class="features-header text-white">we have merch!</h1>
                <hr class="features-divider">
                <p class="text-lg">
                sport the <a href="1995">95</a> degrees logo on various items like shirts and stickers! 
                </p>
                <p class="text-lg">
                    our collection is available over on redbubble.
                </p>
            </div>
            <div>
                <a href="https://www.redbubble.com/people/ThisIsntNath/shop" target="_blank">
                    <MainButton customClass="mt-8 lg:mt-0">
                        <Icon name="shirt" class="w-8 mr-4"/>
                        browse on redbubble
                    </MainButton>
                </a>
            </div>
        </div>
    </Container>
</div>


<style>
    .merch-bg-img {
        background-image:url(/assets/bg/merch-bg.png);
        background-size:cover;
        background-position:center;
        box-shadow:0px 0px 20px #00000090 inset;
    }
</style>