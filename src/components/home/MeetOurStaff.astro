---
import Container from "../common/Container.astro";
import StaffList from "./MeetOurStaff/StaffList.astro";
import StaffCard from "./MeetOurStaff/StaffCard.astro";

const url = "https://api.saku.dev/spin-dash/avatar/";
---

<div id="meet-our-staff" class="bg-brand-light text-white border-t border-b border-brand-dark">
    <Container customClass="filter drop-shadow-xl" smaller={false}>
        <!-- staff -->
        <h2 class="title text-current">meet our staff</h2>
        <StaffList>
            <StaffCard
                name="Nath" 
                role="Manager"
                icon={url + '117369638320340998.png'}
                socialLink="https://thisisntnath.carrd.co/"
            />

            <StaffCard
                name="jaetpa" 
                role="Assistant"
                icon={url + '146608140899581952.png'}
            />

            <StaffCard
                name="TagmanBeesley" 
                role="Barista"
                icon={url + '147801925230788608.png'}
                socialLink="https://twitter.com/tagmanbeesley"
            />

            <StaffCard
                name="Saku" 
                role="Barista / Developer"
                icon={url + '255673616342056961.png'}
            />

            <StaffCard
                name="VoidInVoid" 
                role="Developer"
                icon={url + '121387133821911040.png'}
            />
        </StaffList>

        <!-- regulars -->
        <h1 class="title text-current md:text-5xl mt-20">& our cafe regulars</h1>
        <p class="md:text-lg max-w-4xl mb-10">cafe regulars are specially chosen members of our community that we think are a good example to follow. they offer additional moderation support with minimal mod abilities.</p>
        <StaffList>
            <StaffCard
                name="AnaArsonist"
                icon={url + '465094881908621313.png'}
                regular={true}
                socialLink="https://anahoward.me"
            />

            <StaffCard
                name="ducky"
                icon={url + '195262865500930057.png'}
                regular={true}
            />

            <StaffCard
                name="Lucy"
                icon={url + '205114957807747072.png'}
                regular={true}
            />

            <StaffCard
                name="MissCharlie"
                icon={url + '590921620810366978.png'}
                regular={true}
            />

            <StaffCard
                name="ohmightyqueen"
                icon={url + '305606797295878144.png'}
                regular={true}
            />

            <StaffCard
                name="Pusheen"
                icon={url + '268718863485632513.png'}
                regular={true}
            />

            <StaffCard
                name="Roy"
                icon={url + '187355065592446976.png'}
                regular={true}
            />

            <StaffCard
                name="Snowystorm"
                icon={url + '384046336271450113.png'}
                regular={true}
            />

            <StaffCard
                name="vlan"
                icon={url + '256167980403130379.png'}
                regular={true}
            />
        </StaffList>
    </Container>
</div>