---
import {Icon} from "astro-icon";

export interface Props {
    title:string;
}
const {title} = Astro.props;
---

<div class="flex flex-col gap-4">
    <div class="flex gap-5 items-center -ml-11">
        <a href="/">
            <Icon name="arrowleft" class="w-5 hover:opacity-60 duration-200"/>
        </a>
        <Icon name="ninetyfive" class="w-12 text-brand-dark"/>
    </div>
    <h1 class="title">{title}</h1>
</div>