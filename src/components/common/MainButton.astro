---
const {customClass, dark} = Astro.props;
---

<div class={`${(dark) ? 'text-gray-900 ring-brand-light hover:bg-brand-light hover:text-gray-50' : 'text-gray-50 ring-gray-50 hover:bg-gray-50 hover:text-gray-900'} p-3 px-6 ring-2 rounded-xl duration-200 lg:text-lg 2xl:text-xl cursor-pointer flex items-center ${customClass}`}>
    <slot/>
</div>